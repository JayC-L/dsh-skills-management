{
  "name": "dsh-skills-management",
  "version": "0.1.0",
  "description": "DSH Skill catalog with file-backed model and user manual invocation controls, live source reads, and no Skill file modifications",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayC-L/dsh-skills-management.git"
  },
  "homepage": "https://github.com/JayC-L/dsh-skills-management#readme",
  "bugs": {
    "url": "https://github.com/JayC-L/dsh-skills-management/issues"
  },
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "locale/",
    "docs/",
    "icon.svg",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/inventory.js && node --check lib/skill-document.js && node --check lib/live-file.js && node --check lib/policy-store.js && node --check lib/policy-provider.js && node --check lib/client.js"
  },
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0"
  },
  "license": "MIT"
}
